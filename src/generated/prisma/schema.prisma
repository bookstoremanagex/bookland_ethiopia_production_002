generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator client_standard {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accounts {
  id             Int            @id @default(autoincrement())
  account_type   String
  account_email  String
  phonenumber    String?
  password       String
  account_status Boolean        @default(true)
  is_deleted     Boolean        @default(false)
  updatedAt      DateTime
  createdAt      DateTime       @default(now())
  deletedAt      DateTime       @default(now())
  name           String         @default("namesample")
  activitylogs   activityLogs[]
  damagedbooks   damagedbooks[]
  notes          notes[]
  roles          roles[]
}

model bookedition {
  id                          Int                     @id @default(autoincrement())
  edition_name                String
  selling_price               Float?
  production_price            Float?
  printing_cost               Float?
  binding_cost                Float?
  design_cost                 Float?
  translation_cost            Float?
  memo                        String?
  book_image_url              String?
  visiblitiy_to_printer       Boolean                 @default(true)
  total_print_count           Int?
  book_id                     Int?
  number_of_pages             Int?
  bookId                      Int
  is_deleted                  Boolean                 @default(false)
  updatedAt                   DateTime
  createdAt                   DateTime                @default(now())
  deletedAt                   DateTime                @default(now())
  editing_cost                Float?
  other_expenses              Float?
  transportation_cost         Float?
  count_remening_for_transfer Int?                    @default(0)
  translator_cost             Float?
  cover_design_cost           Float?
  text_design_cost            Float?
  editor_cost                 Float?
  typewriting_cost            Float?
  store_cost                  Float?
  distribution_cost           Float?
  advertisement_cost          Float?
  purchasing_right_cost       Float?
  locked_editions             locked_editions[]
  books                       books                   @relation(fields: [bookId], references: [id], map: "BookEdition_bookId_fkey")
  bookeditionstores           bookeditionstores[]
  bookeditionprinters         bookeditionprinters[]
  bookshopeditions            bookshopeditions[]
  damagedbooks                damagedbooks[]
  order_items                 order_items[]
  retail_purchase_items       retail_purchase_items[]
  printorder_items            printorder_items[]
  round_books                 roundbooks[]

  @@index([bookId], map: "BookEdition_bookId_fkey")
}

model bookeditionstores {
  id          Int         @id @default(autoincrement())
  editionId   Int
  quantity    Int?        @default(0)
  storeId     Int
  is_deleted  Boolean     @default(false)
  updatedAt   DateTime
  createdAt   DateTime    @default(now())
  deletedAt   DateTime    @default(now())
  bookedition bookedition @relation(fields: [editionId], references: [id], onDelete: Cascade, map: "BookEditionStores_editionId_fkey")
  stores      stores      @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "BookEditionStores_storeId_fkey")

  @@index([editionId], map: "BookEditionStores_editionId_fkey")
  @@index([storeId], map: "BookEditionStores_storeId_fkey")
}

model bookeditionprinters {
  id          Int         @id @default(autoincrement())
  editionId   Int
  quantity    Int?        @default(0)
  printerId   Int
  is_deleted  Boolean     @default(false)
  updatedAt   DateTime
  createdAt   DateTime    @default(now())
  deletedAt   DateTime    @default(now())
  bookedition bookedition @relation(fields: [editionId], references: [id], onDelete: Cascade, map: "BookEditionPrinters_editionId_fkey")
  printer     printer     @relation(fields: [printerId], references: [id], onDelete: Cascade, map: "BookEditionPrinters_printerId_fkey")

  @@index([editionId], map: "BookEditionPrinters_editionId_fkey")
  @@index([printerId], map: "BookEditionPrinters_printerId_fkey")
}

model books {
  id              Int  @id @default(autoincrement())
  book_sort_index Int? @default(10000)

  unique_identification_code    String                  @unique(map: "Books_unique_identification_code_key")
  isbn                          String?
  title                         String
  author                        String?
  translator                    String?
  designer                      String?
  language                      String?
  edition                       String?
  category                      String?
  publication_year              String
  copyright_registration_number String?
  print_batch_id                String?
  book_sku                      String                  @unique(map: "Books_book_sku_key")
  number_of_pages               Int?
  info                          String?
  book_image_url                String?
  status                        String                  @default("available")
  is_deleted                    Boolean                 @default(false)
  updatedAt                     DateTime
  createdAt                     DateTime                @default(now())
  deletedAt                     DateTime                @default(now())
  productionstatus              books_productionstatus? @default(ON_PRODUCTION)
  round_book                    roundbooks[]
  default_edition_id            String?
  pen_name                      String?
  translator_cost               Float?
  cover_design_cost             Float?
  text_design_cost              Float?
  editor_cost                   Float?
  typewriting_cost              Float?
  store_cost                    Float?
  distribution_cost             Float?
  advertisement_cost            Float?
  purchasing_right_cost         Float?
  available_for_retail          Boolean                 @default(false)
  bookedition                   bookedition[]
  damagedbooks                  damagedbooks[]
  translatorbook                translatorbook[]

  @@index([book_sku], map: "Books_book_sku_idx")
  @@index([unique_identification_code], map: "Books_unique_identification_code_idx")
  @@index([title])
  @@index([author])
  @@index([category])
}

model locked_editions {
  id            Int                    @id @default(autoincrement())
  editionId     Int
  amount_locked Int                    @default(0)
  order_id      Int
  status        locked_editions_status @default(locked)
  is_deleted    Boolean                @default(false)
  updatedAt     DateTime
  createdAt     DateTime               @default(now())
  deletedAt     DateTime               @default(now())

  bookedition bookedition @relation(fields: [editionId], references: [id], onDelete: Cascade, map: "LockedEditions_editionId_fkey")
  orders      orders      @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "LockedEditions_order_id_fkey")
}

enum locked_editions_status {
  locked
  unlocked
}

model bookshopeditions {
  id               Int         @id @default(autoincrement())
  bookShopId       Int
  bookEditionId    Int
  quantity         Int         @default(0)
  price_per_peice  Float?
  total_price      Float?
  memo             String?
  already_paid     Float?
  remaining_amount Float?      @default(0)
  is_deleted       Boolean     @default(false)
  updatedAt        DateTime
  createdAt        DateTime    @default(now())
  deletedAt        DateTime    @default(now())
  bookedition      bookedition @relation(fields: [bookEditionId], references: [id], onDelete: Cascade, map: "BookShopEditions_bookEditionId_fkey")
  bookshopes       bookshopes  @relation(fields: [bookShopId], references: [id], onDelete: Cascade, map: "BookShopEditions_bookShopId_fkey")

  @@index([bookEditionId], map: "BookShopEditions_bookEditionId_fkey")
  @@index([bookShopId], map: "BookShopEditions_bookShopId_fkey")
}

model bookshopes {
  id               Int                @id @default(autoincrement())
  name             String
  location         String
  branch           String?
  phone            String?
  email            String?
  is_deleted       Boolean            @default(false)
  updatedAt        DateTime
  createdAt        DateTime           @default(now())
  deletedAt        DateTime           @default(now())
  previousDebt     Float              @default(0)
  bookshopeditions bookshopeditions[]
  orders           orders[]
  payments         payments[]
  roundrecords     roundrecords[]
}

model orders {
  id                 Int               @id @default(autoincrement())
  bookShopId         Int
  order_type         String // "requested" or "on round"
  memo               String?           @db.Text
  hide_remaining     Boolean           @default(false)
  is_approved        Boolean           @default(false)
  total_amount       Float             @default(0)
  amount_paid        Float             @default(0)
  payment_type       String?           @default("DIRECT") // "DIRECT" | "CHECK"
  check_id           Int?
  status             String            @default("Pending")
  is_deleted         Boolean           @default(false)
  allocation_summary String?           @db.Text
  delivery           Boolean           @default(false)
  delivered_by       Int?
  locked_editions    locked_editions[]
  updatedAt          DateTime          @updatedAt
  createdAt          DateTime          @default(now())
  bookshopes         bookshopes        @relation(fields: [bookShopId], references: [id], onDelete: Cascade)
  checks             checks?           @relation(fields: [check_id], references: [id])
  order_items        order_items[]
}

model order_items {
  id             Int         @id @default(autoincrement())
  orderId        Int
  bookEditionId  Int
  quantity       Int
  price_at_order Float
  order          orders      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookedition    bookedition @relation(fields: [bookEditionId], references: [id], onDelete: Cascade)
}

model damagedbooks {
  id          Int                @id @default(autoincrement())
  type        damagedbooks_type?
  book_id     Int?
  store_id    Int?
  printer_id  Int?
  edition_id  Int?
  count       Int?
  memo        String?
  account_id  Int?
  is_deleted  Boolean            @default(false)
  updatedAt   DateTime
  createdAt   DateTime           @default(now())
  deletedAt   DateTime           @default(now())
  accounts    accounts?          @relation(fields: [account_id], references: [id], map: "DamagedBooks_account_id_fkey")
  books       books?             @relation(fields: [book_id], references: [id], map: "DamagedBooks_book_id_fkey")
  bookedition bookedition?       @relation(fields: [edition_id], references: [id], map: "DamagedBooks_edition_id_fkey")
  stores      stores?            @relation(fields: [store_id], references: [id], map: "DamagedBooks_store_id_fkey")
  printer     printer?           @relation(fields: [printer_id], references: [id], map: "DamagedBooks_printer_id_fkey")

  @@index([account_id], map: "DamagedBooks_account_id_fkey")
  @@index([book_id], map: "DamagedBooks_book_id_fkey")
  @@index([edition_id], map: "DamagedBooks_edition_id_fkey")
  @@index([store_id], map: "DamagedBooks_store_id_fkey")
  @@index([printer_id], map: "DamagedBooks_printer_id_fkey")
}

model dashboardmenu {
  id        Int      @id @default(autoincrement())
  role      String   @unique(map: "DashboardMenu_role_key")
  menus     String   @db.LongText
  updatedAt DateTime
  createdAt DateTime @default(now())
}

model menus {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  parentId   Int?
  order      Int      @default(0)
  is_deleted Boolean  @default(false)
  updatedAt  DateTime
  createdAt  DateTime @default(now())
  deletedAt  DateTime @default(now())

  parent          menus?            @relation("MenuHierarchy", fields: [parentId], references: [id])
  children        menus[]           @relation("MenuHierarchy")
  menu_management menu_management[]

  @@index([parentId])
}

model menu_management {
  id           Int      @id @default(autoincrement())
  account_type String
  menuId       Int
  is_deleted   Boolean  @default(false)
  updatedAt    DateTime
  createdAt    DateTime @default(now())
  deletedAt    DateTime @default(now())

  menus menus @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([account_type, menuId])
  @@index([account_type])
}

model printer {
  id       Int     @id @default(autoincrement())
  name     String
  location String
  phone    String?
  email    String?

  status              String                @default("available")
  is_deleted          Boolean               @default(false)
  updatedAt           DateTime
  createdAt           DateTime              @default(now())
  deletedAt           DateTime              @default(now())
  printorder          printorder[]
  bookeditionprinters bookeditionprinters[]
  damagedbooks        damagedbooks[]
}

model printorder {
  id                  Int                   @id @default(autoincrement())
  project_name        String?
  quality             String?
  count               Int?
  total_price         Float?
  additional_price    Float?
  status              printorder_status     @default(NOT_STARTED)
  memo                String?
  tracking            printorder_tracking   @default(NOT_SET)
  startDate           DateTime?
  endDate             DateTime?
  printerId           Int
  edition             String?
  is_deleted          Boolean               @default(false)
  updatedAt           DateTime
  createdAt           DateTime              @default(now())
  deletedAt           DateTime              @default(now())
  printer             printer               @relation(fields: [printerId], references: [id], onDelete: Cascade, map: "PrintOrder_printerId_fkey")
  printorder_items    printorder_items[]
  printorder_payments printorder_payments[]

  @@index([printerId], map: "PrintOrder_printerId_fkey")
}

model printorder_payments {
  id            Int        @id @default(autoincrement())
  printorder_id Int
  amount        Float
  bookEditionId Int?
  payment_date  DateTime
  reference     String?
  createdAt     DateTime   @default(now())
  printorder    printorder @relation(fields: [printorder_id], references: [id], onDelete: Cascade)

  @@index([printorder_id])
}

model printer_delivery_records {
  id                 Int @id @default(autoincrement())
  printorder_item_id Int

  printorderId        printorder_items @relation(fields: [printorder_item_id], references: [id], onDelete: Cascade)
  storeId             Int?
  quantity_deliverd   Int?
  approvedByPrinter   Boolean          @default(false)
  approvedByPrinterAt DateTime?
  is_deleted          Boolean          @default(false)
  updatedAt           DateTime         @updatedAt
  createdAt           DateTime         @default(now())
}

model printorder_items {
  id             Int               @id @default(autoincrement())
  printorder_id  Int
  bookEditionId  Int
  quantity       Int               @default(0)
  price_per_book Float             @default(0)
  total_price    Float             @default(0)
  content        String?           @db.Text
  status         printorder_status @default(NOT_STARTED)
  is_deleted     Boolean           @default(false)
  updatedAt      DateTime          @updatedAt
  createdAt      DateTime          @default(now())

  printer_delivery_records printer_delivery_records[]

  printorder  printorder  @relation(fields: [printorder_id], references: [id], onDelete: Cascade)
  bookedition bookedition @relation(fields: [bookEditionId], references: [id], onDelete: Cascade)

  @@index([printorder_id])
  @@index([bookEditionId])
}

model roletypes {
  id          Int      @id @default(autoincrement())
  rolename    String   @unique
  role_detail String?
  is_deleted  Boolean  @default(false)
  updatedAt   DateTime
  createdAt   DateTime @default(now())
  deletedAt   DateTime @default(now())
  roles       roles[]

  @@index([rolename])
}

model roles {
  id          Int       @id @default(autoincrement())
  role_status Boolean   @default(false)
  accountId   Int
  roletypeId  Int
  is_deleted  Boolean   @default(false)
  updatedAt   DateTime
  createdAt   DateTime  @default(now())
  deletedAt   DateTime  @default(now())
  accounts    accounts  @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "Roles_accountId_fkey")
  roletypes   roletypes @relation(fields: [roletypeId], references: [id], onDelete: Cascade, map: "Roles_roletypeId_fkey")

  @@index([accountId], map: "Roles_accountId_fkey")
  @@index([roletypeId], map: "Roles_roletypeId_fkey")
}

model stores {
  id                Int                 @id @default(autoincrement())
  name              String
  location          String
  phone             String?
  email             String?
  status            String              @default("available")
  is_deleted        Boolean             @default(false)
  updatedAt         DateTime
  createdAt         DateTime            @default(now())
  deletedAt         DateTime            @default(now())
  bookeditionstores bookeditionstores[]
  damagedbooks      damagedbooks[]
}

model translator {
  id             Int              @id @default(autoincrement())
  name           String?
  phoneNumber    String?
  email          String?
  is_deleted     Boolean          @default(false)
  updatedAt      DateTime
  createdAt      DateTime         @default(now())
  deletedAt      DateTime         @default(now())
  pen_name       String?
  translatorbook translatorbook[]
}

model translatorbook {
  id             Int                           @id @default(autoincrement())
  book_id        Int?
  bookId         Int
  translator_id  Int
  Status         translatorbook_Status         @default(NOT_STARTED)
  cost           Float?
  payment_status translatorbook_payment_status @default(PENDING)
  currently_paid Float                         @default(0)
  startDate      DateTime?
  endDate        DateTime?
  is_deleted     Boolean                       @default(false)
  updatedAt      DateTime
  createdAt      DateTime                      @default(now())
  deletedAt      DateTime                      @default(now())
  books          books                         @relation(fields: [bookId], references: [id], map: "TranslatorBook_bookId_fkey")
  translator     translator                    @relation(fields: [translator_id], references: [id], map: "TranslatorBook_translator_id_fkey")

  @@index([bookId], map: "TranslatorBook_bookId_fkey")
  @@index([translator_id], map: "TranslatorBook_translator_id_fkey")
}

model notification {
  id                Int             @id @default(autoincrement())
  title             String?
  message           String?
  details           String?         @db.LongText
  type              String?
  notification_to   notification_to @default(ADMIN)
  notification_from String?
  accountId         Int?            @map("account_id")
  is_read           Boolean         @default(false)
  is_deleted        Boolean         @default(false)
  updatedAt         DateTime
  createdAt         DateTime        @default(now())
  deletedAt         DateTime        @default(now())

  @@index([accountId])
}

model activityLogs {
  id         Int      @id @default(autoincrement())
  accountId  Int
  action     String   @db.Text
  details    String?  @db.LongText
  ipAddress  String?
  userAgent  String?  @db.Text
  is_deleted Boolean  @default(false)
  updatedAt  DateTime
  createdAt  DateTime @default(now())
  deletedAt  DateTime @default(now())
  account    accounts @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "ActivityLogs_accountId_fkey")

  @@index([accountId], map: "ActivityLogs_accountId_fkey")
}

model notes {
  id           Int      @id @default(autoincrement())
  title        String?
  note_content String   @db.Text
  accountId    Int
  is_deleted   Boolean  @default(false)
  updatedAt    DateTime
  createdAt    DateTime @default(now())
  accounts     accounts @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "Notes_accountId_fkey")

  @@index([accountId], map: "Notes_accountId_fkey")
}

model contracts {
  id         Int       @id @default(autoincrement())
  title      String
  party      String
  type       String
  status     String    @default("Active")
  details    String    @db.Text
  value      Float?
  memo       String?   @db.Text
  dateSigned DateTime?
  startDate  DateTime?
  endDate    DateTime?
  is_deleted Boolean   @default(false)
  updatedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

model roundbooks {
  id              Int            @id @default(autoincrement())
  status          Boolean        @default(true)
  bookId          Int
  editionId       Int?
  editions        bookedition?   @relation(fields: [editionId], references: [id])
  book            books          @relation(fields: [bookId], references: [id])
  round_records   roundrecords[]
  starting_amount Int?
  returned_amount Int?
  allocated       Boolean        @default(false)
  is_deleted      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now())
}

model roundrecords {
  id             Int              @id @default(autoincrement())
  RoundBooks     roundbooks       @relation(fields: [roundbookId], references: [id])
  status         String           @default("PENDING")
  roundbookId    Int
  bookshop_id    Int?
  totalprice     Float?
  round_payments round_payments[]
  bookshop       bookshopes?      @relation(fields: [bookshop_id], references: [id])
  is_deleted     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
}

model round_payments {
  id            Int          @id @default(autoincrement())
  shopId        Int
  amount        Float
  payment_type  String // "DIRECT" | "CHECK"
  checkId       Int?
  status        String       @default("PENDING") // "PENDING" | "APPROVED"
  is_deleted    Boolean      @default(false)
  updatedAt     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  deletedAt     DateTime     @default(now())
  orderid       String?
  roundrecord   roundrecords @relation(fields: [roundrecordId], references: [id])
  roundrecordId Int
  memo          String?      @db.Text

  check round_checks? @relation(fields: [checkId], references: [id])
}

model round_checks {
  id           Int          @id @default(autoincrement())
  username     String?
  bankname     String?
  type         check_types?
  amount       String?
  recordeddate DateTime?
  memo         String?
  imageUrl     String?      @db.Text
  status       check_status @default(PENDING)
  is_deleted   Boolean      @default(false)
  deletedAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
  createdAt    DateTime     @default(now())

  round_payments round_payments[]
}

model print_agreements {
  id               Int       @id @default(autoincrement())
  bookTitle        String
  printerName      String
  quantity         Int
  status           String    @default("Active")
  commencementDate DateTime?
  cost             Float?
  terms            String?   @db.Text
  memo             String?   @db.Text
  is_deleted       Boolean   @default(false)
  updatedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())
}

model delivery_notes {
  id             Int       @id @default(autoincrement())
  deliveryNumber String
  receiverName   String
  driverName     String
  vehiclePlate   String?
  status         String    @default("Pending")
  deliveryDate   DateTime?
  items          String    @db.Text
  memo           String?   @db.Text
  is_deleted     Boolean   @default(false)
  updatedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
}

model invoices {
  id            Int       @id @default(autoincrement())
  invoiceNumber String
  customerName  String
  amount        Float
  status        String    @default("Unpaid")
  dueDate       DateTime?
  issueDate     DateTime?
  imageUrl      String?   @db.Text
  memo          String?   @db.Text
  is_deleted    Boolean   @default(false)
  updatedAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model approval_documents {
  id             Int       @id @default(autoincrement())
  documentNumber String
  title          String
  requestedBy    String
  approvedBy     String?
  status         String    @default("Pending")
  approvalDate   DateTime?
  details        String    @db.Text
  memo           String?   @db.Text
  is_deleted     Boolean   @default(false)
  updatedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
}

model settings {
  id             Int      @id @default(autoincrement())
  primaryColor   String   @default("#408A71")
  badgeColor     String   @default("#059669")
  toastBgColor   String   @default("#FFFFFF")
  toastTextColor String   @default("#1E293B")
  updatedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
}

model checks {
  id           Int          @id @default(autoincrement())
  username     String?
  bankname     String?
  type         check_types?
  amount       String?
  recordeddate DateTime?
  expirydate   DateTime?
  memo         String?
  imageUrl     String?      @db.Text
  status       check_status @default(PENDING)
  is_deleted   Boolean      @default(false)
  deletedAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
  createdAt    DateTime     @default(now())
  payments     payments[]
  orders       orders[]
}

model payments {
  id                    Int        @id @default(autoincrement())
  shopId                Int
  amount                Float
  payment_type          String // "DIRECT" | "CHECK"
  checkId               Int?
  image                 String?
  status                String     @default("PENDING") // "PENDING" | "APPROVED"
  is_deleted            Boolean    @default(false)
  updatedAt             DateTime   @default(now())
  createdAt             DateTime   @default(now())
  deletedAt             DateTime   @default(now())
  orderid               String?
  is_for_previous_debts Boolean?   @default(false)
  memo                  String?    @db.Text
  shop                  bookshopes @relation(fields: [shopId], references: [id])
  check                 checks?    @relation(fields: [checkId], references: [id])
}

enum retail_purchase_status {
  PENDING
  APPROVED
  PARTIALLY_PAID
  PAID
}

model retail_purchases {
  id           Int                    @id @default(autoincrement())
  name         String?
  date         DateTime?
  total_amount Float?
  amount_paid  Float?                 @default(0)
  status       retail_purchase_status @default(PENDING)
  memo         String?                @db.Text
  created_by   Int?
  is_deleted   Boolean                @default(false)
  updatedAt    DateTime               @default(now())
  createdAt    DateTime               @default(now())
  deletedAt    DateTime               @default(now())

  items retail_purchase_items[]
}

model retail_purchase_items {
  id          Int     @id @default(autoincrement())
  purchase_id Int
  edition_id  Int
  quantity    Int?
  unit_price  Float?
  is_deleted  Boolean @default(false)

  purchase retail_purchases @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  edition  bookedition      @relation(fields: [edition_id], references: [id])

  @@index([purchase_id])
  @@index([edition_id])
}

model local_backup_records {
  id            Int      @id @default(autoincrement())
  databaseName  String
  fileSizeBytes Int?
  status        String   @default("success") // "success" | "failed"
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

